# Copy to .env and fill in. Never commit .env.

# --- Backend (Spring Boot) ---
# Local dev uses compose.yaml automatically; set these for Neon/Upstash.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/mealplanner?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATA_REDIS_URL=rediss://default:<password>@<upstash-host>:6379

# LLM (off by default). Enable Gemini free tier:
# SPRING_AI_MODEL_CHAT=google-genai
# SPRING_AI_GOOGLE_GENAI_API_KEY=

# --- Web (Next.js) ---
# BACKEND_URL=http://localhost:8080
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Ingest (Python) ---
# DATABASE_URL=postgresql://mealplanner:mealplanner@localhost:5433/mealplanner
